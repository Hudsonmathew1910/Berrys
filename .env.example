# Copy to .env (or .env.local) and fill in. Never commit real values.

# --- Site ---------------------------------------------------------------
# Public address of the site, no trailing slash. Google sends people back to
# SITE_URL/auth/google/callback, so it must match what you register at Google.
SITE_URL=http://localhost:3000

# --- Supabase: database + product photo storage ---------------------------
# Project Settings → API (or Data API) → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings → API Keys → service_role / secret key. Server only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Connect. App runtime: the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations: the session pooler (port 5432).
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional. Max DB connections per server instance (default 5; 3 recommended on Vercel).
# DATABASE_POOL_MAX=3
# Optional. Supabase CA certificate (PEM, \n for newlines) to verify the database
# server's identity. Without it the connection is still encrypted (TLS).
# Supabase -> Database settings -> SSL configuration -> Download certificate.
# DATABASE_CA_CERT=

# --- Login: Google ---------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: SITE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Login: mobile number OTP (Firebase Phone Authentication) -----------
# Off by default: Google login only. Set to true (with the Firebase values
# below) to show mobile login and require a verified mobile at checkout.
PHONE_LOGIN_ENABLED=false
# Real SMS codes, sent by Google. Firebase console -> Project settings -> General
# -> Your apps -> Web app config. The API key is a public identifier, not a secret.
# Enable Authentication -> Sign-in method -> Phone, and add the site's domain
# under Authentication -> Settings -> Authorized domains.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Optional, defaults to <project-id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN=

# --- Store owner & dashboard -----------------------------------------------
# This Google account is always a shop admin. On first visit to the dashboard
# it is asked to create the dashboard password.
STORE_OWNER_EMAIL=
# Secret dashboard address (one word, letters/digits/dashes), e.g.
# berrys-office-7k2 -> https://your-site/berrys-office-7k2
# Everyone who isn't admin/staff gets "Page not found" there. /admin is not used.
ADMIN_PATH=berrys-admin

# --- Payments --------------------------------------------------------------
# LOCAL TESTING WITHOUT A RAZORPAY ACCOUNT: PAYMENT_MODE=mock simulates the
# payment. Only works with `npm run dev`; production builds ignore it.
# PAYMENT_MODE=mock

# Razorpay (Dashboard → Account & Settings → API Keys). rzp_test_ keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL SITE_URL/api/webhooks/razorpay,
# events payment.captured + order.paid, and the secret you set there.
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (optional, whole rupees) ----------------------------------
# NEXT_PUBLIC_SHIPPING_FEE=99
# NEXT_PUBLIC_FREE_SHIPPING_ABOVE=999

# --- Order confirmation emails to customers (optional) ------------------
# Option A - Gmail, free, no domain (about 500 emails/day). Turn on 2-Step
# Verification for the Gmail account, then create an App password at
# https://myaccount.google.com/apppasswords and paste the 16 letters here.
# SMTP_USER=yourshop@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Option B - Resend (https://resend.com), needs a verified domain. Used only
# when SMTP_USER/SMTP_PASS are not set.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Berry's <orders@your-domain.com>
